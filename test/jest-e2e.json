{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^pg$": "<rootDir>/../node_modules/pg/lib/index.js"
  },
  "rootDir": "..",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/jest-setup.ts"],
  "testRegex": "test/.+\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "test/tsconfig.json"
      }
    ]
  }
}

# Copy this file to `.env` and configure for your environment.
# The API requires all SAML variables to be set.

# =============================================================================
# Server Configuration
# =============================================================================

# Listen port (default 8080)
PORT=

# Allowed browser `Origin` values (comma-separated, no trailing slash).
# Use the SAME host as in browser URL bar (127.0.0.1 vs localhost matters for cookies).
# CORS_ORIGIN=

# =============================================================================
# SAML 2.0 Service Provider (PIONIER.id compatible)
# =============================================================================

# SP Entity ID (must match registration in IdP metadata)
# For production: use your public URL
SAML_SP_ENTITY_ID=

# Assertion Consumer Service URL (POST endpoint for SAML responses)
SAML_ACS_URL=

# Redirect URL after successful SAML login (frontend home page)
SAML_LOGIN_SUCCESS_URL=

# JWT secret for signing session tokens (CHANGE IN PRODUCTION!)
SAML_JWT_SECRET=

# -----------------------------------------------------------------------------
# IdP Configuration - Choose ONE: Local Test IdP OR UAM Production
# -----------------------------------------------------------------------------

# --- Option A: Local Test IdP (SimpleSAMLphp on port 8081) ---
# SAML_IDP_ENTRY_POINT=
# SAML_IDP_LOGOUT_URL=
# SAML_IDP_CERT_PATH=

# --- Option B: UAM Production IdP (sso.amu.edu.pl) ---
SAML_IDP_ENTRY_POINT=
SAML_IDP_LOGOUT_URL=
SAML_IDP_CERT_PATH=

# -----------------------------------------------------------------------------
# SP Certificate & Private Key (PEM)
# -----------------------------------------------------------------------------
# Pre-generated for development
# For production: generate new certificates and register with IdP

SAML_SP_CERT_PATH=
SAML_SP_PRIVATE_KEY_PATH=

# --- Dev SAML bypass (never enable in production) ---
# Requires NODE_ENV != production. Seeds autoryzacja.uzytkownicy (+ lecturer autoryzacja.konta when profile=lecturer).
# SAML_BYPASS_ENABLED=true
# Optional org id for lecturer bypass when that row exists in autoryzacja.organizacje (otherwise first org or seed row).
# SAML_BYPASS_ORGANIZATION_ID=1

# --- Opaque bearer tokens (`autoryzacja.tokens` — groups / drive JSON `auth` field) ---
# Storage = hex(HMAC_SHA256(API_TOKEN_HMAC_SECRET, plaintext)); plaintext only from POST /api/login.
# API_TOKEN_HMAC_SECRET=
# Optional lifetime in seconds.
# API_TOKEN_TTL_SECONDS=

# --- PostgreSQL (required for groups/drive/enrollment APIs) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_NAME=your_db_name
# Set to true only for local/dev schema bootstrap — prefer migrations (`npm run typeorm:migration:run`) when TYPEORM_SYNC=false.
# TYPEORM_SYNC=false
# Run pending migrations on Nest bootstrap (optional; containers often use `typeorm:migration:run:dist` after build instead).
# TYPEORM_MIGRATIONS_RUN=false

# --- Drive file storage (multipart /drive) ---
# Absolute or cwd-relative root; final path: <DRIVE_STORAGE_ROOT>/drive/<organizationId>/<uuid>
# DRIVE_STORAGE_ROOT=./storage
# DRIVE_DEFAULT_ORGANIZATION_ID=1
# DRIVE_MAX_FILE_BYTES=15728640
# Copy this file to `.env` and configure for your environment.
# The API requires all SAML variables to be set.

# =============================================================================
# Server Configuration
# =============================================================================

# Listen port (default 8080)
PORT=8080

# Allowed browser `Origin` values (comma-separated, no trailing slash).
# Use the SAME host as in browser URL bar (127.0.0.1 vs localhost matters for cookies).
# CORS_ORIGIN=http://127.0.0.1:3000

# =============================================================================
# SAML 2.0 Service Provider (PIONIER.id compatible)
# =============================================================================

# SP Entity ID (must match registration in IdP metadata)
# For production: use your public URL
SAML_SP_ENTITY_ID=http://127.0.0.1:8080/api/auth/saml/metadata

# Assertion Consumer Service URL (POST endpoint for SAML responses)
SAML_ACS_URL=http://127.0.0.1:8080/api/auth/saml/acs

# Redirect URL after successful SAML login (frontend home page)
SAML_LOGIN_SUCCESS_URL=http://127.0.0.1:3000

# JWT secret for signing session tokens (CHANGE IN PRODUCTION!)
SAML_JWT_SECRET=replace-with-a-long-random-secret-for-production

# -----------------------------------------------------------------------------
# IdP Configuration - Choose ONE: Local Test IdP OR UAM Production
# -----------------------------------------------------------------------------

# --- Option A: Local Test IdP (SimpleSAMLphp on port 8081) ---
# SAML_IDP_ENTRY_POINT=http://127.0.0.1:8081/simplesaml/saml2/idp/SSOService.php
# SAML_IDP_LOGOUT_URL=http://127.0.0.1:8081/simplesaml/saml2/idp/SingleLogoutService.php
# SAML_IDP_CERT_PATH=../test-idp/idp-cert.pem

# --- Option B: UAM Production IdP (sso.amu.edu.pl) ---
SAML_IDP_ENTRY_POINT=https://sso.amu.edu.pl/simplesaml/saml2/idp/SSOService.php
SAML_IDP_LOGOUT_URL=https://sso.amu.edu.pl/simplesaml/saml2/idp/SingleLogoutService.php
SAML_IDP_CERT_PATH=../secrets/saml/uam-idp-signing.pem

# -----------------------------------------------------------------------------
# SP Certificate & Private Key (PEM)
# -----------------------------------------------------------------------------
# Pre-generated for development in secrets/saml/
# For production: generate new certificates and register with IdP

SAML_SP_CERT_PATH=../secrets/saml/nest-sp-cert.pem
SAML_SP_PRIVATE_KEY_PATH=../secrets/saml/nest-sp-key.pem

# Copy this file to `.env` and configure for your environment.
# The API requires all environment variables to be set.

# =============================================================================
# Project Configuration
# =============================================================================

NODE_ENV=development

# =============================================================================
# Server Configuration
# =============================================================================

# Listen port
PORT=8080

# Interactive OpenAPI UI at /api/docs. Unset = enabled in non-production, disabled in production.
# SWAGGER_ENABLED=true

# Allowed browser `Origin` values (comma-separated, no trailing slash).
# Use the SAME host as in browser URL bar (127.0.0.1 vs localhost matters for cookies).
# CORS_ORIGIN=

# =============================================================================
# SAML 2.0 Service Provider (PIONIER.id compatible)
# =============================================================================

# SP Entity ID (must match registration in IdP metadata)
# For production: use your public URL
SAML_SP_ENTITY_ID=

# Assertion Consumer Service URL (POST endpoint for SAML responses)
# Local dev: use the SPA origin so auth cookies land on the same host as the UI (Vite/Docker nginx proxy `/api`).
# Example: http://127.0.0.1:3000/api/auth/saml/acs (not :8080 unless the browser calls the API directly on 8080).
SAML_ACS_URL=

# Redirect URL after successful SAML login (frontend — prefer `/login` for registration wizard)
SAML_LOGIN_SUCCESS_URL=

# Redirect URL after SAML logout (frontend — prefer `/welcome?loggedOut=1`)
# SAML_LOGOUT_URL=

# JWT secret for signing session tokens (CHANGE IN PRODUCTION!)
SAML_JWT_SECRET=

# IdP settings are stored per organization in PostgreSQL (auth.organizations + auth.idp_certificates).
# Register orgs via POST /api/admin/organizations with metadataUrl (see docs/saml-local-idp.md).

# Local SimpleSAMLphp IdP (development only) — used when running `docker compose up idp` or `npm run idp:up`.
# Single password for federation admin UI and maq-idp-users CRUD (default: admin).
IDP_ADMIN_PASSWORD=

# Optional overrides for local IdP SP trust (defaults match UI proxy on 3000):
# SAML_ACS_URL=http://127.0.0.1:3000/api/auth/saml/acs
# SAML_SLO_URL=http://127.0.0.1:3000/api/auth/saml/slo

# =============================================================================
# Super admin bootstrap (first startup)
# =============================================================================
# When no auth.accounts row with role `super` exists, grant super to this email
# (case-insensitive match on auth.users.email) on startup if the user exists,
# or on first SAML login with that email.
# SUPERADMIN_BOOTSTRAP_EMAIL=administrator@localhost.invalid
# Optional organization for the bootstrap super account (default: private org 1):
# SUPERADMIN_BOOTSTRAP_ORGANIZATION_ID=1

# Organization ids (migration 015):
#   1     — MAQ internal/super tenant only (not a client institution)
#   2–10  — reserved for dev/test SAML (e.g. `npm run register:org` / localhost IdP)
#   11+   — production universities (`npm run register:org -- --production ...`)
# After defence, remove a demo SAML org: `npm run unregister:org -- --id 2`

# -----------------------------------------------------------------------------
# SP Certificate & Private Key (PEM) — generate locally, do not commit
# -----------------------------------------------------------------------------
# Same pattern as production (/opt/maq): paths relative to API cwd (/app in Docker).
# Requires docker-compose volume: ../secrets:/app/secrets:ro
#
# SAML_SP_CERT_PATH=./secrets/saml/nest-sp-cert.pem
# SAML_SP_PRIVATE_KEY_PATH=./secrets/saml/nest-sp-key.pem
#
# npm run start:dev on the host (no Docker API) — use workspace-relative paths instead:
# SAML_SP_CERT_PATH=../secrets/saml/nest-sp-cert.pem
# SAML_SP_PRIVATE_KEY_PATH=../secrets/saml/nest-sp-key.pem

SAML_SP_CERT_PATH=
SAML_SP_PRIVATE_KEY_PATH=

# =============================================================================
# Session Configuration (auth.sessions)
# =============================================================================
# Sessions are stored as HMAC digests in auth.sessions; plaintext lives only in HttpOnly maq_session cookie.
# HMAC secret (min 32 chars in production; local dev uses fallback):
# SESSION_HMAC_SECRET=
# Legacy aliases (deprecated, for migration): API_TOKEN_HMAC_SECRET, API_TOKEN_IDLE_TIMEOUT_SECONDS, API_TOKEN_ABSOLUTE_MAX_SECONDS
#
# Sliding idle timeout (seconds): session expires this long after the last request. Default 31536000 (365 days).
# SESSION_IDLE_TIMEOUT_SECONDS=31536000
# Absolute maximum session lifetime (seconds) from creation; idle refresh never extends past this. Default 31536000 (365 days).
# SESSION_ABSOLUTE_MAX_SECONDS=31536000

# =============================================================================
# Email magic link login (non-PIONIER accounts)
# =============================================================================
# SMTP for magic-link emails — UAM student mail (@st.amu.edu.pl, Microsoft 365):
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=you@st.amu.edu.pl
# SMTP_PASSWORD=          # account password, or app password if MFA is enabled
# During development, SMTP_FROM must match SMTP_USER (M365 only allows sending as yourself).
# After project defence, switch to @maq.amu.edu.pl / @wmi.amu.edu.pl service mail if available:
# SMTP_FROM="MyAcademyQuest <you@st.amu.edu.pl>"
# MAGIC_LINK_EMAIL_SUBJECT=Login Request
# MAGIC_LINK_EMAIL_BODY=Click the link below to sign in to MyAcademyQuest:\n\n{{link}}\n\nThe link expires in a few minutes.
# SPA route that consumes ?token= from the email (no trailing slash):
# MAGIC_LINK_VERIFY_BASE_URL=http://127.0.0.1:3000/login/magic
# Client tenants: register-org.mjs --email-only, then npm run register:user -- user@… --org-id <tenantId>
# Roles: npm run grant:user-role / npm run revoke:user-role -- <email> --org-id <id> --student|--lecturer|--administrator|--super
# Org 1 is MAQ internal/super only (npm run register:user -- … --org-id 1 --allow-internal-org)
# Link validity (seconds) — default 180 (3 minutes):
# MAGIC_LINK_EXPIRY_SECONDS=180
# Cooldown before another request when previous link was not used (seconds) — default 300 (5 minutes):
# MAGIC_LINK_COOLDOWN_SECONDS=300

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
# User/password/name must match the Compose `db` service (same values in this file).
#
# Nest on host + Compose db (npm run start:dev):
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
#
# API in Docker (DATABASE_HOST=db inside compose network, or host.docker.internal from container):
# DATABASE_HOST=host.docker.internal
# DATABASE_PORT=24680
#
# register-org.mjs / idp/scripts/* run on the host and map host.docker.internal / db → 127.0.0.1 automatically.

DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=db_user
DATABASE_PASSWORD=db_password
DATABASE_NAME=db_name
# Local Docker: any non-empty user/name/password work; `maq.sql` init runs as this user (no fixed `dev_user` role).

# Required for most remote PostgreSQL hosts (e.g. TLS-only university servers). Local Docker Postgres: omit or false.
# DATABASE_SSL=true

# Optional: set to false if the server uses a cert not in the default trust store (default: true when SSL is on).
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Set to true only for local/dev schema bootstrap — prefer migrations (`npm run migrate`) when TYPEORM_SYNC=false.
# TYPEORM_SYNC=false

# Optional: run pending migrations inside Nest bootstrap (default: false — Docker entrypoint runs migrations first).
# TYPEORM_MIGRATIONS_RUN=false

# --- Production server (/opt/maq) ---
# NODE_ENV=production
# DATABASE_HOST=<remote-postgres-host>
# DATABASE_SSL=true
# API_TOKEN_HMAC_SECRET=<min 32 chars>
# SAML_SP_CERT_PATH=/app/secrets/sp-cert.pem
# SAML_SP_PRIVATE_KEY_PATH=/app/secrets/sp-key.pem
# SAML_IDP_CERT_PATH=/app/secrets/idp-cert.pem
# See docs/production-deployment.md

# =============================================================================
# Drive File Storage Configuration
# =============================================================================

# Absolute or cwd-relative root; final path: <DRIVE_STORAGE_ROOT>/drive/<organizationId>/<uuid>
DRIVE_STORAGE_ROOT=./storage
DRIVE_DEFAULT_ORGANIZATION_ID=1
DRIVE_MAX_FILE_BYTES=4194304
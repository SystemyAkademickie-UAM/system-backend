{
  "name": "system-backend",
  "version": "0.0.1",
  "description": "NestJS API for Systemy Akademickie UAM",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "db:up": "docker compose up -d db --wait",
    "start": "npm run db:up && npm run migrate && nest start",
    "start:docker": "docker compose up --build -d --wait",
    "start:dev": "npm run db:up && npm run migrate && nest start --watch",
    "start:debug": "npm run db:up && npm run migrate && nest start --debug --watch",
    "start:prod": "npm run migrate:dist && node dist/main.js",
    "migrate": "npm run typeorm:migration:run",
    "migrate:dist": "npm run typeorm:migration:run:dist",
    "migration:new": "node ./scripts/migration-new.mjs",
    "docker": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:downv": "docker compose down -v",
    "docker:build": "docker compose up -d --build",
    "docker:rebuild": "docker compose down -v && docker compose up -d --build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "typeorm:migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./src/database/data-source.ts",
    "typeorm:migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./src/database/data-source.ts",
    "typeorm:migration:run:dist": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/database/data-source.js",
    "typeorm:migration:revert:dist": "node ./node_modules/typeorm/cli.js migration:revert -d ./dist/database/data-source.js",
    "idp:up": "docker compose -f idp/docker-compose.yml up -d --wait",
    "idp:down": "docker compose -f idp/docker-compose.yml down",
    "register:org": "node ./scripts/node-cli.mjs ./scripts/register-org.mjs",
    "register:user": "node ./scripts/node-cli.mjs ./scripts/register-user.mjs",
    "grant:user-role": "node ./scripts/node-cli.mjs ./scripts/grant-user-role.mjs",
    "revoke:user-role": "node ./scripts/node-cli.mjs ./scripts/revoke-user-role.mjs",
    "unregister:user": "node ./scripts/node-cli.mjs ./scripts/unregister-user.mjs",
    "unregister:org": "node ./scripts/node-cli.mjs ./scripts/unregister-org.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@node-saml/passport-saml": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.2.0",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "selfsigned": "^5.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "multer": "2.2.0",
    "js-yaml": "5.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
